<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Firebase Analytics adds the advertising-ID permission; we don't use it (privacy policy says so). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />

    <application
        android:name=".KhanqahApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Khanqah">
        <service
            android:name=".ListeningForegroundService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
        <service
            android:name=".PlaybackNotificationService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
        <receiver
            android:name=".PlaybackControlReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ennbi.khanqah.PLAYBACK_TOGGLE" />
                <action android:name="com.ennbi.khanqah.PLAYBACK_STOP" />
            </intent-filter>
        </receiver>

        <service
            android:name=".KhanqahFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Khanqah.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- No advertising ID in Analytics (see the AD_ID permission removal above). -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
    </application>
</manifest>
